<?php require('template/header.phtml'); ?>

<div class="container mt-4">
    <h3 class="mb-4">All Registered Pets</h3>

    <!-- Success / Error Alerts -->
    <?php if (!empty($view->successMessage)): ?>
        <div class="alert alert-success"><?= htmlspecialchars($view->successMessage) ?></div>
    <?php endif; ?>

    <?php if (!empty($view->errorMessage)): ?>
        <div class="alert alert-danger"><?= htmlspecialchars($view->errorMessage) ?></div>
    <?php endif; ?>

    <?php if (empty($view->pets)): ?>
        <div class="alert alert-info">No pets have been registered yet.</div>
    <?php else: ?>
        <div class="row">
            <?php foreach ($view->pets as $pet): ?>
                <?php
                $status = $pet->getStatus();
                $statusText = ($status === 'Lost') ? 'Missing' : (($status === 'Found') ? 'Sighted' : ucfirst($status));
                $statusClass = ($status === 'Lost') ? 'border-danger' : 'border-info';
                $statusColor = ($status === 'Lost') ? 'text-danger' : 'text-primary';
                ?>

                <div class="col-md-4 mb-3">
                    <div class="card h-100 <?= $statusClass ?> border-start border-4 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <?= htmlspecialchars($pet->getName()) ?>
                                (<?= htmlspecialchars($pet->getSpecies()) ?>)
                            </h5>

                            <p class="card-text mb-1">
                                <strong>Status:</strong>
                                <span class="<?= $statusColor ?> fw-bold"><?= $statusText ?></span>
                            </p>

                            <p class="card-text mb-1">
                                <strong>Breed:</strong> <?= htmlspecialchars($pet->getBreed() ?: 'Unknown') ?><br>
                                <strong>Color:</strong> <?= htmlspecialchars($pet->getColor() ?: 'Unknown') ?><br>
                                <strong>Location:</strong> <?= htmlspecialchars($pet->getDescription() ?: 'Not provided') ?>
                            </p>

                            <small class="text-muted">
                                Reported on <?= htmlspecialchars($pet->getFormattedReportDate()) ?>
                            </small>
                        </div>

                        <!-- Delete Button for Admins -->
                        <?php if (isset($_SESSION['role']) && $_SESSION['role'] === 'admin'): ?>
                            <div class="card-footer bg-transparent border-top d-flex justify-content-end">
                                <form action="pets.php" method="post" class="m-0">
                                    <input type="hidden" name="id" value="<?= $pet->getId() ?>">
                                    <button type="submit" name="delete_pet"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this pet?');">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        <?php endif; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>

<?php require('template/footer.phtml'); ?>
