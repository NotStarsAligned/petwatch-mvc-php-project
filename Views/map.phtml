            // Whether the current user is authenticated (controls form UX)
            isLoggedIn: <?= $view->isLoggedIn ? 'true' : 'false' ?>,

            // Fallback map centre (Manchester city centre)
            defaultLat:  53.4808,
            defaultLng:  -2.2426,
            defaultZoom: 13,
        });
    });
